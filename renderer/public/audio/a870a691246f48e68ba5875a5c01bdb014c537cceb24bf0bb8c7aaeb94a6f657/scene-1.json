  "beats": [
    {
      "text": "First, warm, moist air rises from oceans or soil.",
      "start": 0.0,
      "end": 3.4386666666666668
    },
    {
      "text": "Next, as it climbs, it cools.",
      "start": 3.558666666666667,
      "end": 5.573958333333334
    },
    {
      "text": "Finally, the cooling causes water vapor to condense into tiny droplets.",
      "start": 5.693958333333334,
      "end": 10.225958333333333
    },
    {
      "text": "Clouds form only when both moisture and cool air are present.",
      "start": 10.345958333333334,
      "end": 13.907916666666667
    }
  ]
}

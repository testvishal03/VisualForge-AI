  "beats": [
    {
      "text": "First, water vapor rises because it's less dense than air.",
      "start": 0.0,
      "end": 3.5393333333333334
    },
    {
      "text": "Next, it moves upward into cooler atmospheric layers.",
      "start": 3.6593333333333335,
      "end": 7.208666666666667
    },
    {
      "text": "Whereas heavier air stays below, the vapor climbs steadily.",
      "start": 7.328666666666667,
      "end": 10.859333333333334
    },
    {
      "text": "This upward movement is key to cloud formation.",
      "start": 10.979333333333333,
      "end": 13.901291666666667
    }
  ]
}

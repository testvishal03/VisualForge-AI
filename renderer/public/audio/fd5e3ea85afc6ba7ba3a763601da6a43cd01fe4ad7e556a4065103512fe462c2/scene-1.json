  "key": "fd5e3ea85afc6ba7ba3a763601da6a43cd01fe4ad7e556a4065103512fe462c2",
  "sha256": "35656f2838367b59c9a9f788fd24ca615a032b2ddaeaa7e5aeec5ed5f191b5fe",
  "duration": 15.439916666666667,
  "beats": [
    {
      "text": "In cities, rain hits concrete and asphalt.",
      "start": 0.0,
      "end": 2.7413333333333334
    },
    {
      "text": "First, water runs off quickly.",
      "start": 2.8613333333333335,
      "end": 4.95
    },
    {
      "text": "Next, it flows into streets and drains.",
      "start": 5.07,
      "end": 7.519958333333333
    },
    {
      "text": "Whereas in forests, rain soaks in.",
      "start": 7.639958333333333,
      "end": 10.112625
    },
    {
      "text": "This runoff causes flooding and less groundwater.",
      "start": 10.232625,
      "end": 12.909958333333334
    },
    {
      "text": "So, cities store less water underground.",
      "start": 13.029958333333333,
      "end": 15.439916666666667
    }
  ]
}

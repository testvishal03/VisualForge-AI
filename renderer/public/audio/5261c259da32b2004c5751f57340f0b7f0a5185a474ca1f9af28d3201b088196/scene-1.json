  "beats": [
    {
      "text": "First, plant roots absorb water from the soil.",
      "start": 0.0,
      "end": 2.707333333333333
    },
    {
      "text": "Next, the water moves up through the plant.",
      "start": 2.8273333333333333,
      "end": 5.1066666666666665
    },
    {
      "text": "Finally, leaves release moisture into the air through transpiration.",
      "start": 5.226666666666667,
      "end": 9.161333333333333
    },
    {
      "text": "This returns water to the atmosphere, completing the cycle.",
      "start": 9.281333333333333,
      "end": 12.705333333333334
    }
  ]
}

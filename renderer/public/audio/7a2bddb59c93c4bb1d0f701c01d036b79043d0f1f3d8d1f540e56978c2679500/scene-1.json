{
  "key": "7a2bddb59c93c4bb1d0f701c01d036b79043d0f1f3d8d1f540e56978c2679500",
  "sha256": "409fe373b873374cbe73052f2c9073e3ec34be4cf4314268ca6903f5bf0bc4f1",
  "duration": 14.497291666666667,
  "beats": [
    {
      "text": "First, water in soil absorbs heat from the sun.",
      "start": 0.0,
      "end": 3.0913333333333335
    },
    {
      "text": "Next, it turns into water vapor and rises into the air.",
      "start": 3.211333333333333,
      "end": 6.846
    },
    {
      "text": "Whereas plants use transpiration, soil evaporates directly.",
      "start": 6.966,
      "end": 10.751333333333333
    },
    {
      "text": "This keeps the water cycle moving, even in dry places.",
      "start": 10.871333333333334,
      "end": 14.497291666666667
    }
  ]
}

  "beats": [
    {
      "text": "The words are different.",
      "start": 0.0,
      "end": 1.4086666666666667
    },
    {
      "text": "But the meaning is very similar.",
      "start": 1.5286666666666666,
      "end": 3.374
    },
    {
      "text": "An embedding-based search system can recognize that similarity.",
      "start": 3.494,
      "end": 7.343333333333334
    },
    {
      "text": "So instead of matching exact text, it compares the meaning of the query with the meaning of stored documents.",
      "start": 7.463333333333333,
      "end": 13.669333333333332
    },
    {
      "text": "This is extremely useful in Generative AI applications.",
      "start": 13.789333333333333,
      "end": 17.543291666666665
    }
  ]
}

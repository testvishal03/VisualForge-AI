{
  "key": "e64ee3336ceec85375f42f86a5938aa123bcc913a5e789bf32029d4b219e799f",
  "sha256": "f9fa26fce460af74a8a38ff521a3fe6792080d5b8076ee92e7d647224722479c",
  "duration": 20.113291666666665,
  "beats": [
    {
      "text": "If two concepts are very different, their vectors tend to be farther apart.",
      "start": 0.0,
      "end": 4.405333333333333
    },
    {
      "text": "For example: “Cat” and “Dog” may appear close together.",
      "start": 4.525333333333333,
      "end": 7.778666666666667
    },
    {
      "text": "“King” and “Queen” may also be close.",
      "start": 7.898666666666666,
      "end": 9.945958333333333
    },
    {
      "text": "“Python” and “Programming” may be nearby.",
      "start": 10.065958333333333,
      "end": 12.315291666666667
    },
    {
      "text": "But “Banana” may be much farther away from “Database.” So embeddings allow AI systems to represent meaning as geometry.",
      "start": 12.435291666666666,
      "end": 20.113291666666665
    }
  ]
}

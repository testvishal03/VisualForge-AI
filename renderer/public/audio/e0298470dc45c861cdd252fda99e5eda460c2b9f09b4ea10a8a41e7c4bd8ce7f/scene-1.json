{
  "key": "e0298470dc45c861cdd252fda99e5eda460c2b9f09b4ea10a8a41e7c4bd8ce7f",
  "sha256": "08c6891d10105fdcf1b37a85ff60be6902c217deebbafadb5b03bb6790c4b53f",
  "duration": 18.416625,
  "beats": [
    {
      "text": "Embeddings can capture semantic similarity.",
      "start": 0.0,
      "end": 2.7826666666666666
    },
    {
      "text": "So the vectors for sentence one and sentence two may be close together.",
      "start": 2.9026666666666667,
      "end": 6.933958333333333
    },
    {
      "text": "The banana sentence would be much farther away.",
      "start": 7.053958333333333,
      "end": 9.687291666666667
    },
    {
      "text": "This is one of the biggest advantages of embeddings.",
      "start": 9.807291666666666,
      "end": 12.770625
    },
    {
      "text": "They allow us to search by meaning, not just exact words.",
      "start": 12.890625,
      "end": 16.42995833333333
    },
    {
      "text": "This is called semantic search.",
      "start": 16.549958333333333,
      "end": 18.416625
    }
  ]
}
